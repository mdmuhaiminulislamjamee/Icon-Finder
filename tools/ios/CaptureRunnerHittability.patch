new file mode 100644
--- /dev/null
+++ b/HittabilityProbe.h
@@ -0,0 +1,8 @@
+#import <XCTest/XCTest.h>
+
+@interface MCProbeTestCase : XCTestCase
+// A nil result means XCTest could not determine an activation point.
+- (NSNumber * _Nullable)probeHittability:(XCUIElement * _Nonnull)element
+                        issueDescription:(NSString * _Nullable * _Nonnull)issueDescription
+    NS_SWIFT_NAME(probeHittability(_:issueDescription:));
+@end
diff --git a/HittabilityProbe.m b/HittabilityProbe.m
new file mode 100644
--- /dev/null
+++ b/HittabilityProbe.m
@@ -0,0 +1,40 @@
+#import "HittabilityProbe.h"
+
+static BOOL MCInvalidActivationPoint(NSString *message) {
+    return [message containsString:@"Failed to determine hittability of"] &&
+           [message containsString:@"Activation point invalid"];
+}
+
+@implementation MCProbeTestCase {
+    BOOL _probing;
+    NSString *_matchedIssue;
+}
+
+- (void)recordIssue:(XCTIssue *)issue {
+    if (_probing && MCInvalidActivationPoint(issue.compactDescription)) {
+        _matchedIssue = [issue.compactDescription copy];
+        return;
+    }
+    [super recordIssue:issue];
+}
+
+- (NSNumber *)probeHittability:(XCUIElement *)element issueDescription:(NSString **)issueDescription {
+    NSNumber *value = nil;
+    _matchedIssue = nil;
+    _probing = YES;
+    @try {
+        value = @(element.isHittable);
+    } @catch (NSException *exception) {
+        if (!_matchedIssue && !MCInvalidActivationPoint(exception.reason)) {
+            @throw;
+        }
+        if (!_matchedIssue) {
+            _matchedIssue = [exception.reason copy];
+        }
+    } @finally {
+        _probing = NO;
+    }
+    *issueDescription = _matchedIssue;
+    return _matchedIssue ? nil : value;
+}
+@end
